# Virtual environments
.venv/
venv/
env/

# Datasets / downloaded data (raw shards + processed images are large & regenerable)
# Anchored to repo root so it does NOT match the src/acnevision/data/ package.
/data/
# Belt-and-suspenders: never commit large data artifacts even if placed elsewhere
*.arrow

# Trained models / checkpoints (regenerable, large) — keep the folders, not contents
models/checkpoints/*
!models/checkpoints/.gitkeep
models/trained/*
!models/trained/.gitkeep

# Generated outputs — keep the folders, not contents
outputs/figures/*
!outputs/figures/.gitkeep
outputs/predictions/*
!outputs/predictions/.gitkeep
outputs/logs/*
!outputs/logs/.gitkeep

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Distribution / build
build/
dist/
*.egg-info/
.eggs/

# Environment / secrets
.env
.env.*

# Jupyter
.ipynb_checkpoints/

# IDE / editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Ultralytics / YOLO stray run outputs and auto-downloaded pretrained weights
runs/
*.pt
